# Supabase cloud sync (optional). Copy to .env and fill in from your
# Supabase project (Project Settings → API):
#   - URL is "Project URL"
#   - ANON KEY is "anon" / "public" API key
# Leave blank to run as a pure local, no-backend reader (sync stays disabled).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
